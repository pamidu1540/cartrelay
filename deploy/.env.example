# ════════════════════════════════════════════════════════════════════════════
#  Logistics Engine v4 — environment variables
#  Copy to .env and fill in real values. NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Shared secret between engine and bot/supervisor.
# Generate: openssl rand -hex 32
INTERNAL_TOKEN=change_me_generate_with__openssl_rand_hex_32

# ── Licensing ─────────────────────────────────────────────────────────────────

# The raw license key issued by your license-manager TUI.
# Format: ENG-XXXX-XXXX-XXXX-XXXX
LICENSE_KEY=ENG-XXXX-XXXX-XXXX-XXXX

# Base URL of your Cloudflare Worker (no trailing slash).
LICENSE_API_URL=https://license.yourcompany.com

# HMAC secret used to verify signed tokens offline.
# Must match the TOKEN_SECRET set in your Cloudflare Worker.
# Generate: openssl rand -hex 32
TOKEN_SECRET=change_me_must_match_worker_TOKEN_SECRET

# ── Optional ──────────────────────────────────────────────────────────────────

# Mapbox Directions API token for road-distance delivery quotes.
# Leave blank to fall back to Haversine × 1.3.
MAPBOX_TOKEN=

# Comma-separated Telegram user IDs allowed to use /admin.
ADMIN_USER_IDS=123456789

# Build version injected via -ldflags. Shown in /health and dashboard.
BUILD_VERSION=4.0.0

# ── Dev bypass (local development only) ──────────────────────────────────────
# Set both to the same random hex string to skip the license check entirely.
# NEVER set these in production.
# DEV_BYPASS_SECRET=
# SKIP_LICENSE_CHECK=
