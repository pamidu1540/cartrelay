# deploy/.env.example — v5
#
# BUG-028 fix: placeholders are syntactically INVALID strings so startup
#              fails immediately if any are left unreplaced.
#
# SEC-013 fix: DEV_BYPASS_SECRET and SKIP_LICENSE_CHECK are NOT present here.
#              Use a separate .env.dev (never committed) for local overrides.
#
# Copy to .env and fill every value before running: docker compose up

# ── Application ────────────────────────────────────────────────────────────────
APP_VERSION=5.0.0
DEPLOY_ENV=production
LOG_LEVEL=info

# ── Telegram ───────────────────────────────────────────────────────────────────
# From @BotFather. Engine refuses to start if this contains REPLACE_.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN

# ── Internal auth ──────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
INTERNAL_TOKEN=REPLACE_WITH_32_BYTE_HEX_SECRET

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=logistics
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=logistics_v5

# ── Mapbox ─────────────────────────────────────────────────────────────────────
# Scope token to Directions API only (SEC-011). Leave blank for Haversine fallback.
MAPBOX_TOKEN=

# ── Admin seed ─────────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs seeded as super_admin on first boot.
ADMIN_USER_IDS=REPLACE_WITH_YOUR_TELEGRAM_USER_ID

# ── Licensing ──────────────────────────────────────────────────────────────────
LICENSE_PUBLIC_KEY=

# ── TLS (SEC-001) ──────────────────────────────────────────────────────────────
# Mount cert/key into the engine container via Docker secret or bind mount.
# Leave blank for plaintext (only acceptable on isolated private networks).
TLS_CERT_FILE=
TLS_KEY_FILE=

# ── Default delivery coordinates ───────────────────────────────────────────────
DEFAULT_LAT=6.9271
DEFAULT_LON=79.8612

# ── OTA updates ────────────────────────────────────────────────────────────────
UPDATE_SERVER_URL=REPLACE_WITH_UPDATE_SERVER_URL
UPDATE_SERVER_SECRET=REPLACE_WITH_UPDATE_SERVER_HMAC_SECRET

# ── Optional tuning ────────────────────────────────────────────────────────────
# GRPC_POOL_SIZE=4
# DB_MAX_CONNS=20
# DB_MIN_CONNS=2
# CATALOG_CACHE_MAX_ITEMS=2000
# MAPBOX_CACHE_MAX_ENTRIES=2000
