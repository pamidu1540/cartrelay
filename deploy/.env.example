# ════════════════════════════════════════════════════════════════════════════
#  Logistics Engine v4 — environment variables
#  Copy this file to .env and fill in real values before running.
#  NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Shared secret between engine and bot/supervisor.
# FIX: Engine now refuses to start if this is empty, preventing the
#      empty-token bypass bug from v3.
# Generate:  openssl rand -hex 32
INTERNAL_TOKEN=change_me_generate_with__openssl_rand_hex_32

# Mapbox Directions API token (used for road-distance pricing).
# If blank, all quotes fall back to Haversine × 1.3.
MAPBOX_TOKEN=your_mapbox_public_token_here

# ── Admin access ──────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs that may use /admin.
# Leave empty to block all admin access.
ADMIN_USER_IDS=123456789,987654321

# ── Build ─────────────────────────────────────────────────────────────────────
# Injected into the engine binary via -ldflags; shown in /health and dashboard.
BUILD_VERSION=4.0.0

# ── License ───────────────────────────────────────────────────────────────────
# For local development only: set both to the same random hex string to
# bypass the RSA license check.
# DEV_BYPASS_SECRET=generate_with__openssl_rand_hex_16
# SKIP_LICENSE_CHECK=<same_value_as_DEV_BYPASS_SECRET>

# ── Depot configuration ───────────────────────────────────────────────────────
# NEW: Supports multiple depots as a JSON array.
# Set in the engine's config table at runtime, or pre-populate by adding a
# SetConfigValue("depots_json", ...) call in InitDatabase.
#
# Single-depot legacy keys (still supported):
# depot_lat=6.9271
# depot_lon=79.8612
# depot_name=Main Warehouse

# ── Pricing (override defaults via engine config table) ───────────────────────
# delivery_base_fare=500       (LKR)
# delivery_rate_per_km=75      (LKR / km)
# tax_rate=0.08                (fraction, e.g. 0.08 = 8%)

# ── OTA updates (optional) ────────────────────────────────────────────────────
# UPDATE_MANIFEST_URL=https://your-update-server.example.com/manifest.json
