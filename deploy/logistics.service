[Unit]
Description=Logistics System (Docker Compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/logistics-system/deploy
EnvironmentFile=/opt/logistics-system/deploy/.env

# Start compose stack (using already pulled images for robust & fast boot)
ExecStart=/usr/bin/docker compose up -d

# Graceful stop
ExecStop=/usr/bin/docker compose stop --timeout 30

# Reload — Pull fresh images and recreate only if the image changed
ExecReload=/bin/bash -c '/usr/bin/docker compose pull && /usr/bin/docker compose up -d'

TimeoutStartSec=180
TimeoutStopSec=45

StandardOutput=journal
StandardError=journal
SyslogIdentifier=logistics

[Install]
WantedBy=multi-user.target
