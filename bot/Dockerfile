FROM python:3.12-slim

WORKDIR /app

COPY bot/pyproject.toml .
COPY bot/src/ ./src/
RUN pip install --no-cache-dir .

# Proto bindings are pre-generated by the CI prep job and committed to the repo.
# Just copy them in directly — no need to re-run protoc at image build time.

HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
    CMD python -c "import grpc; ch=grpc.insecure_channel('unix:///app/sockets/logistics.sock'); ch.close()" || exit 1

WORKDIR /app/src

CMD ["python", "main.py"]
